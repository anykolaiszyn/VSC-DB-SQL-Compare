{
  "name": "paritylens",
  "private": true,
  "version": "0.0.1",
  "description": "ParityLens monorepo root",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.9.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vitest": "^3.2.6"
  }
}
