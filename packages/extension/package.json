{
  "name": "paritylens",
  "publisher": "parity-lens-dev",
  "version": "0.0.1",
  "description": "ParityLens VS Code extension host",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "src/index.ts",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onView:paritylens.dataParityView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "paritylens",
          "title": "Data Parity",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "paritylens": [
        {
          "id": "paritylens.dataParityView",
          "name": "Data Parity"
        }
      ]
    },
    "commands": [
      {
        "command": "paritylens.runComparison",
        "title": "ParityLens: Run Comparison"
      }
    ]
  },
  "scripts": {
    "test": "vitest run",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@paritylens/engine": "*",
    "@paritylens/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.85.0"
  }
}
