{
  "name": "paritylens",
  "publisher": "parity-lens-dev",
  "version": "0.0.1",
  "description": "ParityLens VS Code extension host",
  "license": "MIT",
  "main": "./dist-bundle/extension.js",
  "types": "src/index.ts",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onView:paritylens.dataParityView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "paritylens",
          "title": "Data Parity",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "paritylens": [
        {
          "id": "paritylens.dataParityView",
          "name": "Data Parity"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "paritylens.dataParityView",
        "contents": "Get started by adding a connection or creating your first comparison.\n[Add a Connection](command:paritylens.addConnection)\n[Create a Comparison](command:paritylens.newComparison)",
        "when": "view == paritylens.dataParityView && paritylens.hasNoContent"
      }
    ],
    "commands": [
      {
        "command": "paritylens.runComparison",
        "title": "ParityLens: Run Comparison"
      },
      {
        "command": "paritylens.addConnection",
        "title": "ParityLens: Add Connection"
      },
      {
        "command": "paritylens.editConnection",
        "title": "ParityLens: Edit Connection"
      },
      {
        "command": "paritylens.deleteConnection",
        "title": "ParityLens: Delete Connection"
      },
      {
        "command": "paritylens.newComparison",
        "title": "ParityLens: New Comparison"
      }
    ],
    "customEditors": [
      {
        "viewType": "paritylens.comparisonEditor",
        "displayName": "ParityLens Comparison Editor",
        "selector": [
          {
            "filenamePattern": "*.paritylens"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "test": "vitest run",
    "bundle": "node esbuild.config.mjs",
    "copy-license": "node -e \"require('fs').copyFileSync(require('path').join('..','..','LICENSE'), require('path').join('LICENSE'))\"",
    "package": "npm run bundle && npm run copy-license && vsce package --no-dependencies"
  },
  "dependencies": {
    "@paritylens/engine": "*",
    "@paritylens/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.85.0"
  }
}
